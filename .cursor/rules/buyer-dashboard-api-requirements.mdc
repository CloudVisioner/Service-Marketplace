  reqTotalViews: Number,
  reqTotalQuotes: Number,
  reqNewQuotesCount: Number,
  createdAt: Date,
  updatedAt: Date
}

// Indexes:
// - reqCreatedByUserId + reqStatus (for buyer queries)
// - reqBuyerOrgId + reqStatus
// - reqCategory + reqStatus
// - createdAt (descending)
// - deadline
```

